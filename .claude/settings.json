{
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "telegram@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(bun scripts/destinatar.ts)",
      "Bash(bun scripts/dream-due.ts)",
      "Bash(bun scripts/dream-due.ts --anuntat)",
      "Bash(bun scripts/dream-due.ts --gata)",
      "Bash(bun scripts/pregateste.ts)",
      "Bash(bun scripts/token.ts --exista)",
      "PowerShell(bun scripts/destinatar.ts)",
      "PowerShell(bun scripts/dream-due.ts)",
      "PowerShell(bun scripts/dream-due.ts --anuntat)",
      "PowerShell(bun scripts/dream-due.ts --gata)",
      "PowerShell(bun scripts/pregateste.ts)",
      "PowerShell(bun scripts/token.ts --exista)",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__edit_message",
      "mcp__plugin_telegram_telegram__download_attachment",
      "Edit(/memory/**)",
      "Edit(/invatat/**)",
      "Edit(/MEMORY.md)",
      "Edit(/GROUND-TRUTH.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/session-inject.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/loop-detector.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/activity-log.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/memory-flush.ts"
          }
        ]
      }
    ]
  }
}
