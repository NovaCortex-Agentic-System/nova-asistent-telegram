{
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "telegram@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(bun scripts/*)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "PowerShell(bun scripts/*)",
      "PowerShell(bun test)",
      "PowerShell(bun test *)",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__edit_message",
      "mcp__plugin_telegram_telegram__download_attachment",
      "Edit(/memory/**)",
      "Edit(/MEMORY.md)",
      "Edit(/GROUND-TRUTH.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/session-inject.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/loop-detector.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/activity-log.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/memory-flush.ts"
          }
        ]
      }
    ]
  }
}
